<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenFruit Studio Setup" Width="850" Height="590"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#222520" Foreground="#EEEFE5" FontFamily="./fonts/#Syne" FontSize="13"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#EEEFE5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Segment" Background="#2D302B" BorderBrush="#383C34"
                    BorderThickness="1" CornerRadius="8" Padding="10,5">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Segment" Property="Background" Value="#3E4935"/>
                <Setter Property="Foreground" Value="#D9E8BD"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Segment" Property="BorderBrush" Value="#50574A"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Segment" Property="BorderBrush" Value="#CBDEAA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Segment" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2D302B"/>
      <Setter Property="Foreground" Value="#EEEFE5"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12"
                    Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#CBDEAA"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#CBDEAA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EEEFE5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Card" Background="#2D302B" BorderBrush="#383C34" BorderThickness="1"
                    CornerRadius="12" Padding="11,8" Margin="0,0,0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter/>
                <Border x:Name="Track" Grid.Column="1" Width="34" Height="19" CornerRadius="10"
                        Background="#454A40" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                  <Ellipse x:Name="Thumb" Width="13" Height="13" Margin="3,0" Fill="#EEEFE5"
                           HorizontalAlignment="Left"/>
                </Border>
                <Border x:Name="InstalledBadge" Grid.Column="1" Visibility="Collapsed"
                        CornerRadius="8" Padding="8,4" Margin="8,0,0,0" Background="#3E4935"
                        VerticalAlignment="Center">
                  <TextBlock Text="Already installed" Foreground="#CBDEAA" FontSize="10"
                             FontFamily="./fonts/#JetBrains Mono"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#CBDEAA"/>
                <Setter TargetName="Thumb" Property="Fill" Value="#253020"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#50574A"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="#CBDEAA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Card" Property="Opacity" Value="0.55"/>
              </Trigger>
              <Trigger Property="Tag" Value="Installed">
                <Setter TargetName="Track" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="InstalledBadge" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Card" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border BorderThickness="1" BorderBrush="#383C34" Background="#222520">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Padding="20" BorderBrush="#383C34" BorderThickness="0,0,1,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2D302B" Offset="0"/>
            <GradientStop Color="#171A16" Offset="0.8"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <StackPanel>
            <TextBlock Text="Setup" FontSize="44" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock Text="Your iOS workspace on Windows." Foreground="#A4AB9A" FontSize="16"/>
          </StackPanel>
          <Image Source="openfruit-studio-icon-512.png" Width="168" Height="168"
                 VerticalAlignment="Center" Margin="0,72,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock x:Name="VersionLabel" Foreground="#A4AB9A" FontSize="11"
                     FontFamily="./fonts/#JetBrains Mono" VerticalAlignment="Bottom"/>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="25,15,25,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="38"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent">
          <TextBlock Text="CONFIGURATION" VerticalAlignment="Center" FontFamily="./fonts/#JetBrains Mono"
                     Foreground="#CBDEAA" FontSize="11"/>
          <Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Padding="9,4" Background="Transparent"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Options">
            <TextBlock Text="Customize your installation" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="Choose where to install Studio and which tools to add."
                       Foreground="#A4AB9A" Margin="0,0,0,13"/>
            <DockPanel Margin="0,0,0,8" LastChildFill="True">
              <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0"/>
              <Border CornerRadius="8" Background="#2D302B" BorderBrush="#454A40" BorderThickness="1">
                <TextBox x:Name="Folder" IsReadOnly="True" Padding="9,7" VerticalContentAlignment="Center"
                         Background="Transparent" BorderThickness="0" Foreground="#EEEFE5"
                         FontFamily="./fonts/#JetBrains Mono" FontSize="11" AutomationProperties.Name="Installation folder"/>
              </Border>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <TextBlock Text="Install for" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#A4AB9A"/>
              <RadioButton x:Name="ForMe" GroupName="Scope" Content="Just me" Margin="0,0,5,0"/>
              <RadioButton x:Name="ForEveryone" GroupName="Scope" Content="All users"/>
            </StackPanel>
            <CheckBox x:Name="Desktop" AutomationProperties.Name="Desktop shortcut">
              <StackPanel>
                <TextBlock Text="Desktop shortcut" FontWeight="SemiBold"/>
                <TextBlock Text="Launch Studio from your desktop." Foreground="#A4AB9A" FontSize="12"/>
              </StackPanel>
            </CheckBox>
            <CheckBox x:Name="Engine" AutomationProperties.Name="OpenFruit engine">
              <StackPanel>
                <TextBlock Text="OpenFruit engine" FontWeight="SemiBold"/>
                <TextBlock Text="Download the latest stable release from GitHub to build iOS apps."
                           Foreground="#A4AB9A" FontSize="12"/>
              </StackPanel>
            </CheckBox>
            <CheckBox x:Name="Git" AutomationProperties.Name="Git for Windows">
              <StackPanel>
                <TextBlock Text="Git for Windows" FontWeight="SemiBold"/>
                <TextBlock Text="Enable Git operations in the IDE." Foreground="#A4AB9A" FontSize="12"/>
              </StackPanel>
            </CheckBox>
            <CheckBox x:Name="Apple" AutomationProperties.Name="Apple Devices">
              <StackPanel>
                <TextBlock Text="Apple Devices" FontWeight="SemiBold"/>
                <TextBlock Text="Connect your iPhone to your PC over USB." Foreground="#A4AB9A" FontSize="12"/>
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
          <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Foreground="#CBDEAA"
                       Background="#2D302B" Visibility="Collapsed" Margin="0,0,0,8"/>
          <DockPanel LastChildFill="True">
            <Button x:Name="Primary" Content="Install Studio" DockPanel.Dock="Right" MinWidth="125"
                    Margin="12,0,0,0" Background="#CBDEAA" Foreground="#253020"/>
            <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="#A4AB9A" FontSize="12"/>
          </DockPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
